// 1. DMux4Way.hdl
CHIP DMux4Way {
    IN in, sel[2];
    OUT a, b, c, d;

    PARTS:
    DMux(in=in , sel=sel[1] , a=out1 , b=out2 );
    DMux(in=out1 , sel=sel[0] , a=a , b=b );
    DMux(in=out2 , sel=sel[0] , a=c , b=d );
}


// 2. DMux8Way.hdl
CHIP DMux8Way {
    IN in, sel[3];
    OUT a, b, c, d, e, f, g, h;

    PARTS:
    DMux(in=in , sel=sel[2] , a=out1 , b=out2 );
    DMux(in=out1 , sel=sel[1] , a=out11 , b=out12 );
    DMux(in=out2 , sel=sel[1] , a=out21 , b=out22 );
    DMux(in= out11, sel=sel[0] , a=a , b=b );
    DMux(in= out12, sel=sel[0] , a=c , b=d );
    DMux(in= out21, sel=sel[0] , a=e , b=f );
    DMux(in= out22, sel=sel[0] , a=g , b=h );
}