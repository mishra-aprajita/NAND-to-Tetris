 * ALU (Arithmetic Logic Unit):
 * Computes out = one of the following functions:
 *                0, 1, -1,
 *                x, y, !x, !y, -x, -y,
 *                x + 1, y + 1, x - 1, y - 1,
 *                x + y, x - y, y - x,
 *                x & y, x | y      
 * on the 16-bit inputs x, y,
 * according to the input bits zx, nx, zy, ny, f, no.
 * In addition, computes the two output bits:
 * if (out == 0) zr = 1, else zr = 0
 * if (out < 0)  ng = 1, else ng = 0

// Implementation: Manipulates the x and y inputs
// and operates on the resulting values, as follows:
// if (zx == 1) sets x = 0        // 16-bit constant
// if (nx == 1) sets x = !x       // bitwise not
// if (zy == 1) sets y = 0        // 16-bit constant
// if (ny == 1) sets y = !y       // bitwise not
// if (f == 1)  sets out = x + y  // integer 2's complement addition
// if (f == 0)  sets out = x & y  // bitwise and
// if (no == 1) sets out = !out   // bitwise not

CHIP ALU {
    IN  
        x[16], y[16],  // 16-bit inputs        
        zx, // zero the x input?
        nx, // negate the x input?
        zy, // zero the y input?
        ny, // negate the y input?
        f,  // compute (out = x + y) or (out = x & y)?
        no; // negate the out output?
    OUT 
        out[16], // 16-bit output
        zr,      // if (out == 0) equals 1, else 0
        ng;      // if (out < 0)  equals 1, else 0

    PARTS:
    
    // condition X
    Mux16(a=x , b=false , sel=zx , out=zx1 );
    Not16(in=zx1 , out=notx1 );
    Mux16(a=zx1 , b=notx1 , sel=nx , out=x1 );
    
    // condition Y
    Mux16(a=y , b=false , sel=zy , out=zy1 );
    Not16(in=zy1 , out=noty1 );
    Mux16(a=zy1 , b=noty1 , sel=ny , out=y1 );
    
    // Main Function 
    Add16(a=x1 , b=y1 , out=addxy );
    And16(a=x1 , b=y1 , out=andxy );
    Mux16(a=andxy , b=addxy , sel=f , out=fout );
    
    // condition output
    Not16(in=fout , out=notfout );
    Mux16(a=fout , b=notfout , sel=no , out=out,
    out[15]=ng, out[0..7]=outlow,out[8..15]=outhigh );
    
    // zr flag : NOR of all 16 bits
    Or8Way(in=outlow , out=orlow );
    Or8Way(in=outhigh , out=orhigh );
    Or(a=orlow , b=orhigh , out=orout );
    Not(in=orout , out=zr );
    
    // yeh not is liye liya hai kyuki jab zr=1
    // tab hai jab or gate ka o/p 0 hai means reverse 
    // hai isliye final output ke liye hum jo bhi
    // ayega uska not lenge 
}